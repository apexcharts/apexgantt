{
  "name": "apexgantt",
  "version": "3.23.1",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/apexcharts/apexgantt"
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "type": "module",
  "main": "./apexgantt.min.js",
  "module": "./apexgantt.es.min.js",
  "types": "./apexgantt.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./apexgantt.d.ts",
        "default": "./apexgantt.es.min.js"
      },
      "require": {
        "types": "./apexgantt.d.ts",
        "default": "./apexgantt.min.js"
      }
    },
    "./ignite-ui": {
      "import": {
        "types": "./ignite-ui.d.ts",
        "default": "./apexgantt.ignite-ui.es.min.js"
      },
      "require": {
        "types": "./ignite-ui.d.ts",
        "default": "./apexgantt.ignite-ui.min.js"
      }
    },
    "./locales/*.json": "./locales/*.json",
    "./locales/*": {
      "import": {
        "types": "./locales/*.d.ts",
        "default": "./locales/*.es.min.js"
      },
      "require": {
        "types": "./locales/*.d.cts",
        "default": "./locales/*.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
